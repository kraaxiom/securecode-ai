{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "type": "object",
  "required": ["id", "rule_id", "file", "line_start", "line_end", "cwe", "owasp_category", "severity", "confidence", "message", "status"],
  "properties": {
    "id": { "type": "string", "description": "Identifiant unique du finding (ex: uuid)" },
    "rule_id": { "type": "string", "description": "Référence à rules/sast/<lang>/<slug>.yaml" },
    "knowledge_ref": { "type": "string", "description": "Référence à knowledge/<categorie>/<slug>.md" },
    "remediation_ref": { "type": "string", "description": "Référence à rules/remediation/<slug>.md" },
    "file": { "type": "string" },
    "line_start": { "type": "integer" },
    "line_end": { "type": "integer" },
    "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
    "owasp_category": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "snippet": { "type": "string" },
    "message": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "patched", "false_positive", "accepted_risk"] },
    "detected_at": { "type": "string", "format": "date-time" }
  }
}
