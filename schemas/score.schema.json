{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Score",
  "type": "object",
  "required": ["overall_score", "asvs_level_achievable", "breakdown", "missing_for_next_level"],
  "properties": {
    "overall_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "asvs_level_achievable": { "type": "integer", "enum": [1, 2, 3] },
    "breakdown": {
      "type": "object",
      "description": "Score pondéré par catégorie, pondérations définies dans SPEC.md section 7",
      "required": [
        "access_control",
        "input_validation_injections",
        "crypto_secrets",
        "config_hardening",
        "session_auth",
        "dependencies_supply_chain",
        "audit_logging"
      ],
      "properties": {
        "access_control": { "type": "number", "description": "Pondération 25%" },
        "input_validation_injections": { "type": "number", "description": "Pondération 20%" },
        "crypto_secrets": { "type": "number", "description": "Pondération 15%" },
        "config_hardening": { "type": "number", "description": "Pondération 15%" },
        "session_auth": { "type": "number", "description": "Pondération 10%" },
        "dependencies_supply_chain": { "type": "number", "description": "Pondération 10%" },
        "audit_logging": { "type": "number", "description": "Pondération 5%" }
      }
    },
    "missing_for_next_level": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Liste des exigences ASVS manquantes pour atteindre le niveau supérieur"
    }
  }
}
